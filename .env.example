# Laravel backend (PRD §7)
VITE_API_BASE_URL=https://api.biblestudy.app
# Free Use Bible API (helloao.org) — public-domain translations, fetched
# directly from the frontend as an alternative to the Laravel Bible service.
# https://bible.helloao.org/docs/sdks/javascript.html
VITE_FREEUSE_BIBLE_API_URL=https://bible.helloao.org
# Which Bible source the app starts on: "laravel" or "freeuse".
# Users can switch anytime from Settings or the reader's translation bar.
VITE_DEFAULT_BIBLE_SOURCE=laravel
# Sync cadence — batch annotation pushes (PRD §9 Scalability: max 1 call / 5s)
VITE_SYNC_INTERVAL_MS=5000
