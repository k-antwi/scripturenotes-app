    "@capacitor/preferences": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dexie": "^4.0.1",
    "konva": "^9.3.6",
    "lucide-vue-next": "^0.365.0",
    "perfect-freehand": "^1.2.0",
    "pinia": "^2.1.7",
